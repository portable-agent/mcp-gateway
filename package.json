{
    "name": "@portable-agent/mcp-gateway",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.17.1",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "tsx watch src/main.ts",
        "start": "node dist/main.js",
        "lint": "eslint . && prettier --check .",
        "format": "prettier --write .",
        "test": "vitest run --coverage",
        "test:watch": "vitest",
        "build": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "@modelcontextprotocol/client": "2.0.0",
        "fastify": "5.12.3",
        "jose": "6.2.12",
        "zod": "4.5.4"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/node": "26.5.0",
        "@vitest/coverage-v8": "5.0.0",
        "eslint": "10.10.0",
        "prettier": "3.9.6",
        "tsx": "4.23.13",
        "typescript": "6.0.3",
        "typescript-eslint": "8.70.0",
        "vitest": "5.0.0"
    }
}
